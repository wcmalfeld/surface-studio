# Where projects are stored (SQLite file). Defaults to ./data/surface-studio.db
SURFACE_DB_PATH=./data/surface-studio.db

# Optional image providers for "Describe a scene". Leave blank to use built-in scenes only.
# Keys stay on the server; the browser never sees them.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell

# Requests per minute per visitor for image generation
SCENE_RATE_LIMIT=8
